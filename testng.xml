<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="E-Commerce Regression Test Suite" verbose="1">

    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="Regression Test Scenarios">
        <classes>
            <class name="tests.HomePageTest"/>
            <class name="tests.LoginTest"/>
            <class name="tests.LoginDataDrivenTest"/>
            <class name="tests.LogoutTest"/>
            <class name="tests.ProductSearchTest"/>
            <class name="tests.CartTest"/>
            <class name="tests.DownloadInvoiceTest"/>
        </classes>
    </test>

</suite>
